[Unit]
Description=pub-hub Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pubhub
Group=pubhub
ExecStart=/usr/local/bin/pubhub-portal -config /etc/pubhub/portal.toml
LoadCredential=hub-api-client-secret:/etc/pubhub/credentials/hub-api-client-secret
LoadCredential=rgw-access-key-id:/etc/pubhub/credentials/rgw-access-key-id
LoadCredential=rgw-secret-access-key:/etc/pubhub/credentials/rgw-secret-access-key
CacheDirectory=pubhub
CacheDirectoryMode=0700
Restart=on-failure
RestartSec=2s

# /run/pubhub holds portal.sock (mode 0660). nginx joins the pubhub group to
# reach it; nothing else can.
RuntimeDirectory=pubhub
RuntimeDirectoryMode=0750
UMask=0007

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
